{
  "name": "@moveindustries/shielded-assets",
  "description": "Movement Shielded Assets SDK — Zcash-style shielded pool (FA-backed)",
  "packageManager": "pnpm@8.15.1",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "bugs": {
    "url": "https://github.com/movementlabsxyz/ts-sdk/issues"
  },
  "homepage": "https://docs.movementnetwork.xyz/",
  "version": "0.3.0",
  "sideEffects": false,
  "main": "dist/common/index.js",
  "module": "dist/esm/index.mjs",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "require": {
        "types": "./dist/common/index.d.ts",
        "default": "./dist/common/index.js"
      },
      "import": {
        "types": "./dist/esm/index.d.mts",
        "default": "./dist/esm/index.mjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build:clean": "rm -rf dist",
    "build": "pnpm build:clean && tsup",
    "build:types": "tsc -p tsconfig.build.json --outDir ./dist/types --declaration --emitDeclarationOnly",
    "test": "pnpm jest"
  },
  "dependencies": {
    "@moveindustries/ts-sdk": "^5.0.0",
    "@noble/ciphers": "^1.0.0",
    "@noble/hashes": "^1.5.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.3",
    "jest": "^30.1.3",
    "ts-jest": "^29.4.2",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  }
}
